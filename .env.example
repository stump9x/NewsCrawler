# --- Notebook AI (Open Notebook sidecar) ---
# All-in-one on same origin:
#   UI:  http://YOUR_IP:3000/notebook-ai
#   API: http://YOUR_IP:3000/api/nb/...  (proxied to notebook-gateway)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-notebook-encryption-key
OPEN_NOTEBOOK_PASSWORD=
OPEN_NOTEBOOK_DISABLE_SPEECH=1
SURREAL_USER=root
SURREAL_PASSWORD=root
NOTEBOOK_INTERNAL_URL=http://notebook-gateway:80
NOTEBOOK_PUBLIC_URL=http://127.0.0.1:3000
# Crawl-body cache (Redis Django cache DB 2): reuse after first read; TTL 3h.
NOTEBOOK_CRAWL_CACHE_ENABLED=True
NOTEBOOK_CRAWL_CACHE_TTL_SEC=10800
NOTEBOOK_CRAWL_CACHE_MAX_CHARS=80000
NOTEBOOK_CRAWL_CACHE_MAX_KEYS=64
# DJANGO_CACHE_URL=redis://:PASSWORD@redis:6379/2
NOTEBOOK_GROQ_CHAT_MODEL=openai/gpt-oss-20b
NOTEBOOK_GROQ_CHAT_MODEL_ALT=openai/gpt-oss-120b
NOTEBOOK_GROQ_STRICT_POOL=True
NOTEBOOK_QWEN_CHAT_MODEL=qwen2.5:3b
NOTEBOOK_QWEN_CHAT_MODEL_FAST=qwen2.5:1.5b
# Interactive Notebook chat: paid ShopAIKey primary → Groq → OpenRouter.
# Cerebras/Ollama remain off the user-facing Chat path.
NOTEBOOK_DEFAULT_CHAT_PROVIDER=shopaikey
# ShopAIKey serves Notebook Chat and the user-triggered Quick Briefing path.
NOTEBOOK_SHOPAIKEY_ENABLED=true
# NOTEBOOK_SHOPAIKEY_API_KEY=
NOTEBOOK_SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
NOTEBOOK_SHOPAIKEY_MODEL_FAST=qwen3-235b-a22b
NOTEBOOK_SHOPAIKEY_MODEL_FAST_FALLBACK=qwen3-next-80b-a3b-instruct
NOTEBOOK_SHOPAIKEY_MODEL_DEEP=qwen3-next-80b-a3b-instruct
NOTEBOOK_SHOPAIKEY_MODEL_FALLBACK=gpt-5-mini
NOTEBOOK_SHOPAIKEY_TIMEOUT_SECONDS=9
# Quick Briefing: paid primary model (uses NOTEBOOK_SHOPAIKEY_API_KEY/base URL).
BRIEFING_SHOPAIKEY_ENABLED=true
BRIEFING_SHOPAIKEY_MODEL=qwen3-235b-a22b
BRIEFING_SHOPAIKEY_TIMEOUT_SECONDS=30
# Optional dedicated Groq key for Notebook (exclude from translate/briefing pools)
# NOTEBOOK_GROQ_API_KEY=
# NOTEBOOK_GROQ_API_KEYS=    # extra Notebook keys (with NOTEBOOK_GROQ_API_KEY)
NOTEBOOK_DIGEST_TIMEOUT_SEC=12
NOTEBOOK_EMBED_MODEL=nomic-embed-text

# --- last30days / Nghiên cứu 30 ngày ---
# LAST30DAYS_ENABLED=true
# LAST30DAYS_DEFAULT_DAYS=30
# LAST30DAYS_MAX_AGE_DAYS=0   # 0 = use each research lookback_days; else hard cap
# LAST30DAYS_SOURCES=reddit,x,polymarket
# LAST30DAYS_GROQ_EXPAND=true
# LAST30DAYS_TRANSLATE_ENABLED=true
# LAST30DAYS_WEB_BACKEND=auto
# WIGOLO_LAST30DAYS_WEB=true
# Direct NewsNow ranked feeds for Xu hướng. Keep the source list focused;
# every fetched item still passes the NewsCrawler topic/country relevance gate.
# TREND_NEWSNOW_ENABLED=true
# TREND_NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# TREND_NEWSNOW_SOURCE_IDS=cls,weibo,zhihu,bilibili,hupu,v2ex
# TREND_NEWSNOW_TIMEOUT_SEC=8

# --- Groq per-task pools (backend) ---
# GROQ_API_KEYS_TRANSLATE=  # wire title + last30days
# GROQ_API_KEYS_BRIEFING=   # AI briefing / Wigolo LLM
# GROQ_API_KEY_BRIEFING=    # first briefing key (Wigolo primary)

# --- Cerebras Cloud (Notebook primary; optional briefing mid-tier; NOT Dòng tin) ---
# CEREBRAS_ENABLED=true
# CEREBRAS_API_KEY=
# CEREBRAS_API_KEYS=key1,key2,...  # rotate like Groq/OpenRouter pools
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_FALLBACK_MODELS=gemma-4-31b,zai-glm-4.7
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_POOL_NAMESPACE=newscrawler
# CEREBRAS_BRIEFING_FALLBACK=true
# NOTEBOOK_CEREBRAS_COMPAT_URL=http://cerebras-proxy:8088/v1
# NOTEBOOK_CEREBRAS_CHAT_MODEL=gpt-oss-120b
# NOTEBOOK_CEREBRAS_FALLBACK_MODELS=gemma-4-31b,zai-glm-4.7

# --- OpenRouter (briefing + Notebook only; NOT Dòng tin title translate) ---
# OPENROUTER_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=key1,key2,key3
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_POOL_NAMESPACE=newscrawler
# OPENROUTER_HTTP_REFERER=https://newscrawler.local
# OPENROUTER_X_TITLE=NewsCrawler
# NOTEBOOK_OPENROUTER_CHAT_MODEL=openrouter/free
# NOTEBOOK_DEFAULT_CHAT_PROVIDER=groq


# --- Wigolo (selective fallback: Jina → Wigolo → Searx). No eager Chromium warmup. ---
WIGOLO_ENABLED=true
WIGOLO_URL=http://wigolo:3333
WIGOLO_FETCH_ENABLED=true
WIGOLO_FETCH_PREFER=false
WIGOLO_EAGER_WARMUP=0
WIGOLO_BRIEFING_ENABLED=true
WIGOLO_BRIEFING_MODE=search
WIGOLO_OSINT_MODE=fallback
WEB_READER_ENABLED=True
TITLE_TRANSLATE_STUCK_SEC=300
TITLE_TRANSLATE_MAX_PENDING=10

# Document PDF dork scan + document title AI (off by default — frees RAM/Groq).
DOCUMENT_SCAN_ENABLED=false


# --- AI briefing wire/item caps (was hard-capped ~28) ---
AI_BRIEFING_MAX_WIRE_ITEMS=200
AI_BRIEFING_WIRE_LIMIT=200
WIRE_MAX_ITEMS=5000
AI_BRIEFING_FETCH_MAX=100
AI_BRIEFING_FETCH_CHARS=14000
AI_BRIEFING_DOSSIER_BODY_CHARS=4500
AI_BRIEFING_DIGEST_SENTENCES=5
AI_BRIEFING_SEARCH_LIMIT=60
AI_BRIEFING_POLISH_DOSSIER_CHARS=36000
AI_BRIEFING_CEREBRAS_PROMPT_CHARS=36000
AI_BRIEFING_OPENROUTER_PROMPT_CHARS=28000
AI_BRIEFING_GROQ_PROMPT_CHARS=10000
AI_BRIEFING_REVIEW_MAX_TOKENS=2800
AI_BRIEFING_GROQ_QUALITY_ASSIST=true
AI_BRIEFING_GROQ_ASSIST_MIN_CHARS=450
AI_BRIEFING_GROQ_LANGUAGE_POLISH=true
AI_BRIEFING_GROQ_FINAL_RETRIES=2
AI_BRIEFING_BODY_MIN_CHARS=4500
AI_BRIEFING_BODY_TARGET_CHARS=6000
AI_BRIEFING_BODY_MAX_CHARS=8000
AI_BRIEFING_QUALITY_FLOOR_CHARS=4500
AI_BRIEFING_REVIEW_PREFER_FAST=false
WIGOLO_BRIEFING_RESEARCH_MAX_SOURCES=80
# Notebook Chat v2: shared context, adaptive provider routing and delayed hedge.
# Keep false for rollback; frontend rebuild is required after changing this flag.
NOTEBOOK_CHAT_V2_ENABLED=false
NOTEBOOK_CHAT_HEDGE_DELAY_MS=1400
NOTEBOOK_CHAT_CLOUD_TIMEOUT_MS=8000
NOTEBOOK_CHAT_LOCAL_TIMEOUT_MS=45000
